        },
        {
          "name": "Test - Inactive student is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Inactive student error', function () {",
                  "    pm.expect(pm.response.json().result).to.eql('ERROR_INACTIVE_STUDENT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"T_INACTIVE\",\"courseID\":\"C_INACTIVE\"}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/registrations"
          }
        }
      ]
    },
