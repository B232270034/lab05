
{
  "info": {
    "name": "Lab05 API Testing",
    "description": "Nine registration tests with independent setup requests and response assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Successful Registration",
      "item": [
        {
          "name": "Setup - Active Student",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/students/T_HAPPY"
          }
        },
        {
          "name": "Setup - Course With Prerequisite",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/courses/C_HAPPY"
          }
        },
        {
          "name": "Test - Registration succeeds",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Intentional failure - expects wrong status', function () {",
                  "pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Result is OK', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.result).to.eql('OK');",
                  "    pm.expect(json.registrationID).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"T_HAPPY\",\"courseID\":\"C_HAPPY\"}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/registrations"
          }
        }
      ]
    },
    {
